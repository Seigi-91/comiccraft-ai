# 默认使用本机 ChatGPT 协作；复制提示词并回填结果，不需要 API 密钥。
AI_PROVIDER=chatgpt_desktop
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
# 文字/视觉 API：也可在网页的「文字与视觉模型连接」中保存
# 与下面独立的 IMAGE_PROVIDER 图片连接自由组合
# AI_PROVIDER=local_http
LOCAL_GPT_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_GPT_API_KEY=
DEFAULT_TEXT_MODEL=gpt
DEFAULT_VISION_MODEL=gpt
DEFAULT_IMAGE_MODEL=gpt-image-1
GPT_TIMEOUT=180
# POSTGRES_URL 留空时使用本地 SQLite

# 独立图像编辑服务，须实际支持 multipart /images/edits 和 PNG 透明蒙版
IMAGE_EDIT_BASE_URL=
IMAGE_EDIT_API_KEY=
IMAGE_EDIT_MODEL=gpt-image-1

# 默认使用 ChatGPT 原图+白色选区蒙版回填。切换自动接口时设为 openai
IMAGE_EDIT_PROVIDER=chatgpt_desktop

# Linux/macOS 中文字体文件路径
COMIC_FONT_PATH=

# 图片生成可独立于 AI_PROVIDER 切换；未设置时兼容旧配置。
# IMAGE_PROVIDER=chatgpt_desktop
# IMAGE_PROVIDER=openai
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_API_MODEL=gpt-image-1
# 无账户鉴权的远程部署请关闭网页配置入口，改用服务端环境变量。
ENABLE_LOCAL_SETTINGS=true

# 每个生成任务的持久 API 请求预留上限；不是金额预算
MAX_MODEL_REQUESTS_PER_TASK=96

# 官方Codex CLI自动连接：安装并使用ChatGPT登录后，选择 AI_PROVIDER=codex_cli。
# 图片仍独立选择；只有真实生图验证通过后再选择 IMAGE_PROVIDER=codex_cli。
CODEX_MODEL=
CODEX_TIMEOUT=600
# 可选：管理员指定原生codex可执行文件或官方codex.js的绝对路径，不接受shell命令。
CODEX_CLI_PATH=

# 默认官方结构化连接，读取原生图片生成附件；exec保留为显式兼容模式。
CODEX_TRANSPORT=app_server
