# Pinned upstream bytes and runtime adaptations are SHA-256 verified.
# Preserve their exact bytes on every platform instead of applying core.autocrlf.
skills/vendor/** -text -whitespace
skills/**/UPSTREAM.md -text whitespace=cr-at-eol

skills/local/** -text

videos/**/assets/lib/*.js -whitespace

# Launch scripts must remain usable on Unix checkouts.
*.sh text eol=lf
*.cmd text eol=crlf

# Video editing source stays browsable on GitHub. Runtime source ZIPs omit it.
/videos export-ignore
/outputs/rain-night-light/雨夜留灯-* export-ignore
